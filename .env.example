# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated. Add your deployed Vercel URL here in production.
CORS_ORIGINS=http://localhost:5173

# --- Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
VISION_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Embeddings (API-based, no local model) ---
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Database ---
# Local dev: relative sqlite file.
# Railway/Render: point at a mounted persistent volume, e.g. sqlite:////data/receiptmind.db
DATABASE_URL=sqlite:///./data/receiptmind.db

# --- Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# --- Extraction ---
EXTRACTION_MAX_RETRIES=2
EXTRACTION_TIMEOUT_SECONDS=45
