# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated. Add your deployed Vercel URL here in production.
CORS_ORIGINS=http://localhost:5173

# --- Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
VISION_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Embeddings (API-based, no local model) ---
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Database ---
# Local dev: relative SQLite file. Production: use the Supabase Postgres URL.
DATABASE_URL=sqlite:///./data/receiptmind.db

# --- Storage ---
# Production Supabase values. Keep the service-role key on the backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# --- Extraction ---
EXTRACTION_MAX_RETRIES=2
EXTRACTION_TIMEOUT_SECONDS=45
